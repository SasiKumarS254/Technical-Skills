#include <stdio.h>
#include <stdlib.h>
struct node {
    int data;
    struct node *left, *right;
};
int main() {
    struct node *root = NULL, *temp, *current;
    int n, value;
    printf("Enter number of elements: ");
    scanf("%d", &n);
    for(int i = 0; i < n; i++) {
        printf("Enter value: ");
        scanf("%d", &value);
        temp = (struct node*)malloc(sizeof(struct node));
        temp->data = value;
        temp->left = temp->right = NULL;
        if(root == NULL) {
            root = temp;
        } else {
            current = root;
            while(1) {
                if(value < current->data) {
                    if(current->left == NULL) {
                        current->left = temp;
                        break;
                    }
                    current = current->left;
                } else {
                    if(current->right == NULL) {
                        current->right = temp;
                        break;
                    }
                    current = current->right;
                }
            }
        }
    }
    printf("Elements inserted into BST");
    return 0;
}
