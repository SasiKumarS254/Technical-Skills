#include<stdio.h>
#define MAX_SIZE 10
int stack[MAX_SIZE];
int top=-1;
int isEmpty()
{
    return (top==-1);
}
int isFull()
{
    return (top==MAX_SIZE-1);
}
void push(int data)
{
    if(isFull())
    {
        printf("stack overflow could not insert data, stack is full\n");
    }
    else
    {
        top++;
        stack[top]=data;
        printf("pushed %d to stack.\n",data);
    }
}
int pop()
{
    if(isEmpty())
    {
        printf("Stack underflow could not retrieve data,stack is empty");
        return -1;
    }
    else
    {
        int data=stack[top];
        top--;
        return data;
    }
}
int peek()
{
    if(isEmpty())
    {
        printf("stack is empty!\n");
        return -1;
    }
    else
    {
        return stack[top];
    }
}
int main()
{
    push(10);
    push(20);
    push(30);
    push(40);
    printf("element at top of the stack is: %d\n",peek());
    printf("Element in the stack(popping):\n");
    while (!isEmpty())
    {
    printf("%d\n",pop());
    }
    printf("stack full: %s\n",isFull() ? "true":"false");
    printf("stack empty: %s\n",isEmpty() ? "true":"false");
    return 0;
}
