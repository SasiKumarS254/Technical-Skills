#include<stdio.h>
int main() {
    int arr[5]={810,25,70,9,42};
    int n=sizeof(arr)/sizeof(arr[0]);
    int max=arr[0];
    int min=arr[0];
    for(int i=0;i<n;i++) {
        if(arr[i]>max) {
            max=arr[i];
        }
    }
    for(int i=0;i<n;i++){
        if(arr[i]<min){
            min=arr[i];
        }
    }
    printf("Maximum number=%d\n",max);
    printf("Minimum number=%d\n",min);
    return 0;
}

