#include <stdio.h>

int main() {
    char str[] = "Hello, World!";
    int n = sizeof(str) / sizeof(str[0]) - 1; // Exclude the null terminator
    char temp;

    for (int i = 0; i < n / 2; i++) {
        temp = str[i];
        str[i] = str[n - i - 1];
        str[n - i - 1] = temp;
    }

    printf("Reversed string: %s\n", str);
    return 0;
}

